OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Workflow Runner v1 executor smoke settings.
# AI_EXECUTOR can be mock, codex, claude, or gemini.
AI_EXECUTOR=mock
AI_EXTERNAL_ROLE=pm

# Optional CLI overrides. Args are split on whitespace.
# Defaults:
# - codex: codex exec --cd <workspace> --sandbox read-only -
# - claude: claude -p
# - gemini: gemini -p ""
CODEX_EXECUTOR_COMMAND=codex
CODEX_EXECUTOR_ARGS=
CLAUDE_EXECUTOR_COMMAND=claude
CLAUDE_EXECUTOR_ARGS=-p
GEMINI_EXECUTOR_COMMAND=gemini
GEMINI_EXECUTOR_ARGS=-p ""
